# Server Configuration
APP_SERVER__HOST=0.0.0.0
APP_SERVER__PORT=8080

# Database Configuration
APP_DATABASE__URL=postgresql://postgres:password@localhost:5432/products
APP_DATABASE__MAX_CONNECTIONS=10
APP_DATABASE__MIN_CONNECTIONS=1
APP_DATABASE__CONNECTION_TIMEOUT=30
APP_DATABASE__IDLE_TIMEOUT=600

# Redis Configuration  
APP_REDIS__URL=redis://localhost:6379
APP_REDIS__POOL_SIZE=10
APP_REDIS__DEFAULT_TTL_SECONDS=3600
APP_REDIS__CONNECTION_TIMEOUT=5

# Logging Configuration
APP_LOGGING__LEVEL=info
APP_LOGGING__FORMAT=json

# External Services (optional)
# APP_EXTERNAL_SERVICES__INVENTORY_SERVICE_URL=http://inventory-service:8081
# APP_EXTERNAL_SERVICES__PRICING_SERVICE_URL=http://pricing-service:8082
# APP_EXTERNAL_SERVICES__NOTIFICATION_SERVICE_URL=http://notification-service:8083

# Environment
APP_ENV=development